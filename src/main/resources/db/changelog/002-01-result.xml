<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0001-create_table_result" author="aboll">
        <createSequence schemaName="public" startValue="1" incrementBy="1" ordered="true" sequenceName="RESULT_SEQ"/>
        <createTable schemaName="public" tableName="RESULT">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reason" type="varchar(20)"/>
            <column name="winner" type="varchar(10)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>