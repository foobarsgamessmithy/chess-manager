<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0001-create_table_move" author="aboll">
        <createSequence schemaName="public" startValue="1" incrementBy="1" ordered="true" sequenceName="MOVE_SEQ"/>
        <createTable schemaName="public" tableName="MOVE">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="field" type="varchar(2)"/>
            <column name="figure" type="varchar(1)"/>
            <column name="has_captured" type="boolean" defaultValue="0"/>
            <column name="promoted" type="varchar(6)"/>
            <column name="is_check" type="boolean" defaultValue="0"/>
            <column name="is_en_passant" type="boolean" defaultValue="0"/>
            <column name="is_made" type="boolean" defaultValue="0"/>
            <column name="result_id" type="bigint" />
            <column name="castle" type="varchar(5)"/>
            <column name="pawn" type="varchar(1)"/>
            <column name="file" type="varchar(1)"/>
            <column name="rank" type="varchar(1)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>