meta {
  name: Create match with result
  type: http
  seq: 4
}

post {
  url: {{url}}/api/match
  body: json
  auth: none
}

headers {
  X-XSRF-TOKEN: {{xsrf-token}}
}

body:json {
  {
    "playedAt":"2024-10-18T12:30:00+02",
    "playedWith":"WHITE",
    "result": {
      "pointsWhite": 0,
      "pointsBlack": 1
    }
  }
}

script:post-response {
  bru.setVar("_matchId",res.body.id)
}
