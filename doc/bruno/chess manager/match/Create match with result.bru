meta {
  name: Create match with result
  type: http
  seq: 4
}

post {
  url: {{url}}/api/match
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "playedAt":"2024-10-18T12:30:00+02",
    "playedWith":"WHITE",
    "result": {
      "winner": "WHITE",
      "reason": "CHECK_MADE",
      "moves": ["e4 e5", "Bc4 Bc6", "Qh5 Nf6", "Qxf7#"]
    }
  }
}

script:post-response {
  bru.setVar("_matchId",res.body.id)
}
