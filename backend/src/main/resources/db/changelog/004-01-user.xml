<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0001-create_table_user" author="aboll">
        <createSequence schemaName="public" startValue="1" incrementBy="1" ordered="true" sequenceName="PLAYER_SEQ"/>
        <createTable schemaName="public" tableName="PLAYER">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="user_name" type="varchar(50)"/>
            <column name="lichess_user_name" type="varchar(50)"/>
            <column name="auto_import" type="boolean" defaultValue="false" />
        </createTable>
    </changeSet>

</databaseChangeLog>