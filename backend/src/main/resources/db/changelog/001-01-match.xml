<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <changeSet id="0001-create_table_match" author="aboll">
        <createTable schemaName="public" tableName="MATCH">
            <column name="match_id" type="JAVA.UTIL.UUID">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="external_id" type="varchar(32)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="played_at" type="java.sql.Types.TIMESTAMP_WITH_TIMEZONE"/>
            <column name="played_with" type="varchar(5)"/>
            <column name="result_id" type="bigint"/>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>